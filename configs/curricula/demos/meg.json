{
  "triggers": {
    "sync": {
      "mode": "send",
      "delay": 0.0
    },
    "backend": "serial",
    "port": "/dev/ttyUSB0",
    "lsl_stream_name": "fmri_gym",
    "pulse_ms": 10,
    "on_frame": true,
    "frame_every": 1,
    "on_episode_start": true,
    "codes": {
      "frame_bits": 3,
      "task_start": 8,
      "task_stop": 16,
      "episode_start": 32,
      "scanner_start": 64
    }
  },
  "curriculum": [
    {
      "type": "message",
      "text": "Pong (Atari)\n\nUP / DOWN move the paddle.\n\n(press SPACE to start)"
    },
    {
      "type": "fixation",
      "duration": 2.0
    },
    {
      "type": "game",
      "backend": "ale",
      "game": "ALE/Pong-v5",
      "mode": "duration",
      "duration": 60.0,
      "fps": 30,
      "keys": {"": 0, "SPACE": 1, "RIGHT": 2, "LEFT": 3, "RIGHT+SPACE": 4, "LEFT+SPACE": 5, "UP": 2, "DOWN": 3}
    },
    {
      "type": "fixation",
      "duration": 2.0
    }
  ]
}
